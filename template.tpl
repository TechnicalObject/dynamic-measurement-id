___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const getUrl = require('getUrl');
const getContainerVersion = require('getContainerVersion');
const log = require('logToConsole');

const measurementId = data.prodMeasurementId;
const devMeasurementId = data.devMeasurementId;
const hostname = (getUrl('host') || '').toLowerCase();
const cv = getContainerVersion();
let isDev = false;

const prodHostnames = data.prodHostnames
  ? data.prodHostnames.split(',').map(h => h.trim().toLowerCase()).filter(h => h.length > 0)
  : [];

if (prodHostnames.length > 0) {
  // Fail closed: anything that is not an explicitly listed production host is DEV.
  isDev = prodHostnames.indexOf(hostname) === -1;
  log('prodHostnames =', prodHostnames, 'host =', hostname, 'isDev =', isDev);
} else if (data.selectionType === 'list' && data.stgHostnames) {
  const stgHostnames = data.stgHostnames.map(item => item.hostname);
  log('stgHostnames =', stgHostnames);
  isDev = stgHostnames.indexOf(hostname) !== -1;
} else if (data.selectionType === 'regex') {
  isDev = !!hostname.match(data.regex);
}

if ((cv.debugMode || isDev) && devMeasurementId && !data.devOverride) {
  return devMeasurementId;
}

// Variables must return a value.
return measurementId;


